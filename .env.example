# Kaggle credentials (for dataset access)
# DO NOT COMMIT ACTUAL VALUES
KAGGLE_USERNAME=your_username
KAGGLE_KEY=your_api_key

# API keys (optional, for cloud inference)
AMHARIC_ASR_API_KEY=
AMHARIC_ASR_API_URL=http://localhost:8000

# Model path (for local inference)
AMHARIC_ASR_MODEL_PATH=models/amharic_asr_int8.onnx

# Server config
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
WORKERS=4

# Training
TRAINING_CONFIG=configs/training.json
CHECKPOINT_DIR=checkpoints
LOG_DIR=logs
